{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "tokenomics-check",
          "version": "1.0.0",
          "informationUri": "https://github.com/INNERLUXES/tokenomics-check",
          "rules": [
            {
              "id": "plan-unreadable",
              "name": "plan-unreadable",
              "shortDescription": {
                "text": "the file is not JSON the reader can follow, or its top level is not an object, so no plan was read"
              },
              "help": {
                "text": "Write the plan as one JSON object (docs/inputs.md), and fix the line named. (input)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "input"
              }
            },
            {
              "id": "field-missing",
              "name": "field-missing",
              "shortDescription": {
                "text": "a field the checks need is not in the plan: the name, symbol, decimals, mintable flag, a supply or the allocations of the token, or the name, kind, amount or percent, or vesting of a bucket, or the month and part of a step of a schedule"
              },
              "help": {
                "text": "Add the field named; docs/inputs.md lists what each part of the plan needs. (input)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "input"
              }
            },
            {
              "id": "field-unknown",
              "name": "field-unknown",
              "shortDescription": {
                "text": "a key the tool does not read, often a misspelt one; its value was left out of every check"
              },
              "help": {
                "text": "Correct the spelling to a key of docs/inputs.md, or remove the key. (input)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "input"
              }
            },
            {
              "id": "field-invalid",
              "name": "field-invalid",
              "shortDescription": {
                "text": "a value of the wrong type or form: text where a number or a flag belongs, a month that is not a whole number, a negative amount, a kind the tool does not know, or two forms of vesting in one bucket"
              },
              "help": {
                "text": "Write the value as docs/inputs.md shows: amounts and supplies as decimal numbers of whole tokens, months as whole numbers, flags as true or false. (input)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "input"
              }
            },
            {
              "id": "bucket-duplicate",
              "name": "bucket-duplicate",
              "shortDescription": {
                "text": "two buckets share a name (compared without case and outer spaces), so a reader cannot tell which line a total comes from"
              },
              "help": {
                "text": "Give each bucket a name of its own, or merge the two. (input)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "input"
              }
            },
            {
              "id": "percent-out-of-range",
              "name": "percent-out-of-range",
              "shortDescription": {
                "text": "a percent below 0 or above 100: the share of a bucket, the part released at launch or a step of a schedule"
              },
              "help": {
                "text": "Give each percent as a number from 0 to 100. (input)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "input"
              }
            },
            {
              "id": "allocation-sum",
              "name": "allocation-sum",
              "shortDescription": {
                "text": "the buckets do not add up to the supply of the plan (the maximum supply when one is given, else the total supply), counted in base units with amounts and percents together"
              },
              "help": {
                "text": "Change the buckets until they add up to the supply exactly, or change the supply. (best practice)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "best practice"
              }
            },
            {
              "id": "percent-rounding",
              "name": "percent-rounding",
              "shortDescription": {
                "text": "a bucket given as a percent of the supply is not a whole number of base units at the decimals of the token, so it is rounded down and the rest is in no bucket"
              },
              "help": {
                "text": "Give the bucket as an amount, or choose a percent that gives whole base units. (documented)"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "amount-precision",
              "name": "amount-precision",
              "shortDescription": {
                "text": "an amount or a supply has more places after the point than the token has decimals, so it cannot be held in base units"
              },
              "help": {
                "text": "Round the amount to the decimals of the token, or raise the decimals. (documented)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "decimals-out-of-range",
              "name": "decimals-out-of-range",
              "shortDescription": {
                "text": "the decimals are not a whole number from 0 to 255, which is what a uint8 on Ethereum and a u8 on Solana hold"
              },
              "help": {
                "text": "Choose decimals from 0 to 255; 18 on an EVM chain unless there is a reason for another value. (documented)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "decimals-unusual",
              "name": "decimals-unusual",
              "shortDescription": {
                "text": "an EVM token with more than 18 decimals, past what the OpenZeppelin guide advises and what Ether uses"
              },
              "help": {
                "text": "Use 18 decimals unless the token has a special reason for more, and check that the wallets and exchanges it will be listed on show more than 18 places. (best practice)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "best practice"
              }
            },
            {
              "id": "supply-overflow",
              "name": "supply-overflow",
              "shortDescription": {
                "text": "the supply in base units does not fit the number the chain keeps it in: a uint256 for ERC-20, a u64 for a Solana mint"
              },
              "help": {
                "text": "Lower the supply or the decimals until the supply in base units fits. (documented)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "supply-over-cap",
              "name": "supply-over-cap",
              "shortDescription": {
                "text": "the total supply of the plan is larger than its maximum supply, so a cap at the maximum would refuse to mint it"
              },
              "help": {
                "text": "Lower the total supply to the maximum, or raise the maximum. (documented)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "mint-cap-missing",
              "name": "mint-cap-missing",
              "shortDescription": {
                "text": "a mintable token states a maximum supply but names nothing that enforces it, such as ERC20Capped or a mint authority set to None"
              },
              "help": {
                "text": "Name the mechanism in capMechanism (ERC20Capped, a cap check in the mint function, a mint authority set to None after the last mint), or make the token not mintable. (documented)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "cliff-over-duration",
              "name": "cliff-over-duration",
              "shortDescription": {
                "text": "a bucket in the VestingWallet form (durationMonths) has a cliff longer than its duration, which VestingWalletCliff refuses"
              },
              "help": {
                "text": "Make the cliff no longer than the duration, or give the months after the cliff with linearMonths. (documented)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "insider-launch-release",
              "name": "insider-launch-release",
              "shortDescription": {
                "text": "a team, insider, advisor or investor bucket releases a part at launch (month 0)"
              },
              "help": {
                "text": "Release nothing to insiders at launch; start their schedule after a cliff. (best practice)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "best practice"
              }
            },
            {
              "id": "insider-no-cliff",
              "name": "insider-no-cliff",
              "shortDescription": {
                "text": "a team, insider, advisor or investor bucket releases a part after launch but before the month of --min-cliff (default 6)"
              },
              "help": {
                "text": "Give the bucket a cliff of at least the months of --min-cliff, or set --min-cliff to the policy of the project. (best practice)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "best practice"
              }
            },
            {
              "id": "vesting-too-short",
              "name": "vesting-too-short",
              "shortDescription": {
                "text": "a team, insider, advisor or investor bucket is fully released before the month of --min-vesting (default 12)"
              },
              "help": {
                "text": "Spread the bucket over at least the months of --min-vesting, or set --min-vesting to the policy of the project. (best practice)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "best practice"
              }
            },
            {
              "id": "vesting-too-long",
              "name": "vesting-too-long",
              "shortDescription": {
                "text": "a bucket still releases after the month of --max-vesting (default 60)"
              },
              "help": {
                "text": "Confirm that the bucket is meant to release for that long, or set --max-vesting to the policy of the project. (best practice)"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "kind": "best practice"
              }
            },
            {
              "id": "schedule-mismatch",
              "name": "schedule-mismatch",
              "shortDescription": {
                "text": "the schedule of a bucket releases more than the bucket holds, or never releases all of it (a schedule that falls short, or a launch part below 100 with no months after it)"
              },
              "help": {
                "text": "Make the steps of the schedule add up to the bucket exactly, or add linearMonths or durationMonths for the part after launch. (best practice)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "best practice"
              }
            },
            {
              "id": "supply-cliff",
              "name": "supply-cliff",
              "shortDescription": {
                "text": "in one month after launch the buckets release more than --cliff-share (default 25) percent of the supply in circulation before that month"
              },
              "help": {
                "text": "Spread the release over more months, stagger the cliffs of the buckets, or confirm that the market can take the release. (best practice)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "best practice"
              }
            },
            {
              "id": "trading-without-float",
              "name": "trading-without-float",
              "shortDescription": {
                "text": "the plan says trading starts at launch, but no liquidity or public sale bucket releases anything at launch"
              },
              "help": {
                "text": "Add a liquidity or public sale bucket with a part released at launch, or set tradingAtLaunch to false. (best practice)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "best practice"
              }
            }
          ]
        }
      },
      "artifacts": [
        {
          "location": {
            "uri": "examples/bad/plan.json"
          }
        }
      ],
      "results": [
        {
          "ruleId": "supply-over-cap",
          "ruleIndex": 12,
          "level": "error",
          "message": {
            "text": "The total supply of 25,000,000 QFX is larger than the maximum supply of 21,212,121 QFX; a cap such as ERC20Capped at the maximum refuses a mint past it with ERC20ExceededCap. Fix: Lower the total supply to the maximum, or raise the maximum."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/plan.json",
                  "index": 0
                },
                "region": {
                  "startLine": 7,
                  "startColumn": 3
                }
              }
            }
          ],
          "properties": {
            "kind": "documented",
            "bucket": null
          }
        },
        {
          "ruleId": "mint-cap-missing",
          "ruleIndex": 13,
          "level": "error",
          "message": {
            "text": "The token is mintable and states a maximum supply of 21,212,121 QFX, but capMechanism names nothing that enforces it, such as ERC20Capped or a cap check in the mint function; while a mint can go on, the maximum is only a promise. Fix: Name the mechanism in capMechanism (ERC20Capped, a cap check in the mint function, a mint authority set to None after the last mint), or make the token not mintable."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/plan.json",
                  "index": 0
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 3
                }
              }
            }
          ],
          "properties": {
            "kind": "documented",
            "bucket": null
          }
        },
        {
          "ruleId": "allocation-sum",
          "ruleIndex": 6,
          "level": "error",
          "message": {
            "text": "The 10 buckets add up to 16,318,181.79 QFX, 76.92% of the maxSupply of 21,212,121 QFX: 4,893,939.21 QFX less than the supply. This is a best practice of this tool, not a rule in EIP-20, the OpenZeppelin Contracts documentation or the Solana documentation. Fix: Change the buckets until they add up to the supply exactly, or change the supply."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
