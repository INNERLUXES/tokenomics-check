          }
        },
        {
          "ruleId": "insider-launch-release",
          "ruleIndex": 15,
          "level": "warning",
          "message": {
            "text": "The bucket Team (team) releases 424,242.42 QFX, 10% of the bucket, at launch; insiders who can sell on the first day weigh on the price before the market has formed. This is a best practice of this tool, not a rule in EIP-20, the OpenZeppelin Contracts documentation or the Solana documentation. Fix: Release nothing to insiders at launch; start their schedule after a cliff."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/plan.json",
                  "index": 0
                },
                "region": {
                  "startLine": 17,
                  "startColumn": 20
                }
              }
            }
          ],
          "properties": {
            "kind": "best practice",
            "bucket": "Team"
          }
        },
        {
          "ruleId": "vesting-too-short",
          "ruleIndex": 17,
          "level": "warning",
          "message": {
            "text": "The bucket Advisors (advisors) is fully released by month 9, before month 12 (--min-vesting). This is a best practice of this tool, not a rule in EIP-20, the OpenZeppelin Contracts documentation or the Solana documentation. Fix: Spread the bucket over at least the months of --min-vesting, or set --min-vesting to the policy of the project."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/plan.json",
                  "index": 0
                },
                "region": {
                  "startLine": 23,
                  "startColumn": 7
                }
              }
            }
          ],
          "properties": {
            "kind": "best practice",
            "bucket": "Advisors"
          }
        },
        {
          "ruleId": "supply-cliff",
          "ruleIndex": 20,
